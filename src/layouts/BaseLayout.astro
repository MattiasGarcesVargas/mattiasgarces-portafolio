---
import { ClientRouter } from "astro:transitions";
import "../shared/styles/global.css";
import { Preloader } from "../features/preloader";
import ScrollProgress from "../shared/ui/ScrollProgress.astro";
import { alternatePath, getLocale, locales, useTranslations } from "../shared/i18n/utils";

interface Props {
  title?: string;
  description?: string;
}

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const { title = t.meta.title, description = t.meta.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = locales.map((l) => ({ locale: l, href: new URL(alternatePath(Astro.url.pathname, l), Astro.site) }));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map(({ locale: l, href }) => <link rel="alternate" hreflang={l} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "es_EC"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f2f0eb" />
    <ClientRouter />
    <script is:inline data-astro-rerun>
      // Runs before paint: enables motion start states and decides whether the trailer plays.
      // It plays on every fresh arrival at the home, reloads included; never on back/forward,
      // on other pages, or when arriving from another page of this site.
      document.documentElement.classList.add("js");
      try {
        var nav = performance.getEntriesByType("navigation")[0];
        var fresh = /^\/(en\/?)?$/.test(location.pathname) && !(nav && nav.type === "back_forward");
        if (fresh && !(nav && nav.type === "reload") && document.referrer) {
          fresh = new URL(document.referrer).origin !== location.origin;
        }
        if (!fresh) document.documentElement.classList.add("is-preloaded");
      } catch {}
    </script>
  </head>
  <body data-theme="paper" data-motion="theme">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-3 focus:text-paper"
    >
      {t.nav.skip}
    </a>
    <Preloader />
    <ScrollProgress />
    <main id="main">
      <slot />
    </main>
    <script>
      import "../shared/motion/core";
      import "../shared/motion/theme";
    </script>
  </body>
</html>
