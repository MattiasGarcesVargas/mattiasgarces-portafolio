---
/** One project as a near-full-screen chapter. Three layouts rotate so the rhythm never repeats twice. */
import ProjectMedia from "./ProjectMedia.astro";
import TechLogo from "../../shared/ui/TechLogo.astro";
import type { Project } from "./data";
import { getLocale, workPath } from "../../shared/i18n/utils";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const locale = getLocale(Astro.url);
const { title, role, stack, year, summary, summaryEn, disclaimer } = project.data;

const layouts = [
  { media: "md:col-start-1 md:col-span-8", text: "md:col-start-9 md:col-span-4", aspect: "16 / 10", textFirst: false },
  { media: "md:col-start-6 md:col-span-7", text: "md:col-start-1 md:col-span-4", aspect: "4 / 3", textFirst: true },
  { media: "md:col-start-2 md:col-span-7", text: "md:col-start-9 md:col-span-4", aspect: "16 / 10", textFirst: false },
] as const;
const layout = layouts[index % layouts.length]!;
const href = workPath(locale, project.id);
const titleId = `chapter-${project.id}`;
---

<article class="px-gutter" aria-labelledby={titleId}>
  <div class="grid grid-cols-12 items-end gap-x-6 gap-y-6">
    <a
      href={href}
      class:list={["col-span-12 block", layout.media, layout.textFirst && "md:row-start-1"]}
      aria-labelledby={titleId}
    >
      <ProjectMedia project={project} aspect={layout.aspect} />
    </a>

    <div class:list={["col-span-12 flex flex-col gap-5", layout.text, layout.textFirst && "md:row-start-1"]}>
      <h3
        id={titleId}
        class="font-display text-[clamp(3rem,6vw,6rem)] leading-[0.9] tracking-[-0.03em]"
      >
        {title}
      </h3>
      <p class="max-w-[40ch] text-base leading-relaxed text-muted">{locale === "en" ? summaryEn : summary}</p>
      <ul class="flex flex-wrap items-center gap-5" aria-label="Stack">
        {
          stack.map((tool) => (
            <li class="text-text/85 transition-colors duration-[400ms] ease-ui hover:text-accent" title={tool}>
              <TechLogo name={tool} />
            </li>
          ))
        }
      </ul>
      <span class="font-mono text-[13px] tracking-[0.02em] text-muted">
        {year ? `${year} · ` : ""}{role.join(", ")}
      </span>
      {disclaimer && <span class="font-mono text-[10px] tracking-[0.08em] text-muted uppercase">{disclaimer}</span>}
    </div>
  </div>
</article>
