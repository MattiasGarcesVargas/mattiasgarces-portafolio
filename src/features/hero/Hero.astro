---
/**
 * Act 01 — the portrait. The trailer cuts to black and the page opens on that same black:
 * Mattias in black and white, his name set across the picture, the first name running into
 * the dark beside his head. Scrolling parts the name like a curtain.
 * Elements marked [data-intro] start hidden only when motion runs (see global.css).
 */
import LangSwitch from "../../shared/ui/LangSwitch.astro";
import LocalTime from "../../shared/ui/LocalTime.astro";
import { getLocale, useTranslations } from "../../shared/i18n/utils";

const t = useTranslations(getLocale(Astro.url));
---

<header
  class="relative flex min-h-svh flex-col justify-between overflow-clip px-gutter pt-7 pb-8"
  data-motion="hero"
  data-theme="ink"
  aria-labelledby="hero-title"
>
  <div class="relative z-10 flex items-start justify-between gap-4" data-hero-out>
    <span class="font-display text-[28px] leading-none tracking-[-0.04em]" data-intro data-hero-fade>MG</span>
    <div class="flex items-center gap-4 sm:gap-6" data-intro data-hero-fade>
      <span class="font-mono text-[13px] tracking-[0.02em] text-muted">{t.brand.city} — <LocalTime /></span>
      <LangSwitch />
    </div>
  </div>

  <div class="stage">
    <figure class="portrait" data-intro data-hero-frame>
      <img
        src="/me/hero.webp"
        alt={t.hero.portraitAlt}
        width="1200"
        height="1500"
        fetchpriority="high"
        decoding="async"
        data-hero-photo
      />
    </figure>

    <h1 id="hero-title" class="name">
      <span class="line line-first" data-hero-line="first">
        <span class="block" data-intro data-hero-word>Mattias</span>
      </span>
      {" "}
      <span class="line line-last" data-hero-line="last">
        <span class="block italic" data-intro data-hero-word>Garcés</span>
      </span>
    </h1>
  </div>

  <div class="relative z-10 flex items-end justify-between gap-6 text-[13px] leading-snug sm:text-sm" data-hero-out>
    <p class="max-w-[11.5rem] sm:max-w-none" data-intro data-hero-fade>
      <span class="block">{t.hero.design}</span>
      <span class="block text-muted">{t.hero.code}</span>
    </p>
    <p class="hidden max-w-80 text-center text-muted lg:block" data-intro data-hero-fade>{t.brand.tagline}</p>
    <p class="text-right whitespace-nowrap" data-intro data-hero-fade>
      <span class="block">{t.hero.available}</span>
      <span class="block text-muted">{t.hero.scroll}</span>
    </p>
  </div>
</header>

<style>
  /*
   * Phones and upright tablets: the name brackets the portrait, each line biting into its edge.
   * The portrait's width is the one measure; the gap between the lines is derived from it.
   */
  .stage {
    --portrait: min(64vw, 46svh);
    position: absolute;
    inset: 0;
    margin-inline: auto;
  }

  .portrait {
    position: absolute;
    inset: 0;
    width: var(--portrait);
    aspect-ratio: 4 / 5;
    margin: auto;
    overflow: clip;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .name {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(var(--portrait) * 1.25 - 0.78em);
    padding-inline: var(--spacing-gutter);
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 24vw, 9rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
  }

  /* Each line is a mask its word rises through; the padding keeps accents and tails inside it. */
  .line {
    display: block;
    overflow: clip;
    padding-block: 0.1em 0.14em;
  }
  .line-first {
    align-self: flex-end;
  }
  .line-last {
    align-self: flex-start;
  }

  /*
   * Wide screens: one composition, 100 units across, that scales as a whole and stays centred
   * when the window is short. "Mattias" hangs from the right edge and runs 12 units into the
   * dark beside his head; "Garcés" starts at the left edge and only grazes the frame.
   */
  @media (min-width: 1024px), (min-width: 640px) and (orientation: landscape) {
    .stage {
      --u: min(1vw, 1.72svh);
      --portrait: calc(36 * var(--u));
      width: calc(100 * var(--u));
    }
    .portrait {
      right: auto;
      left: calc(38.4 * var(--u) - var(--spacing-gutter));
    }
    .name {
      gap: calc(9 * var(--u));
      font-size: calc(17 * var(--u));
    }
  }
</style>

<script>
  import "./hero.motion";
</script>
