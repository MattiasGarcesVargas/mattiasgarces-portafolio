---
/**
 * Act 02 — the manifesto. Words go from faint to full ink as you scroll.
 * Without JS or with reduced motion the paragraph is simply fully readable.
 */
import { getLocale, useTranslations } from "../../shared/i18n/utils";

const t = useTranslations(getLocale(Astro.url));
---

<section
  class="px-gutter pt-[clamp(7rem,12vw,10rem)] pb-[clamp(8rem,14vw,12.5rem)]"
  data-motion="manifesto"
  data-theme="paper"
  aria-labelledby="manifesto-title"
>
  <div class="grid grid-cols-12 gap-x-6 gap-y-6">
    <h2 id="manifesto-title" class="sr-only">{t.manifesto.label}</h2>
    <p
      class="col-span-12 text-[clamp(1.875rem,4vw,3.625rem)] leading-[1.1] tracking-[-0.028em] md:col-span-10 md:col-start-3 lg:col-span-9 lg:col-start-3"
      data-manifesto-text
    >
      {
        t.manifesto.text.map((part) =>
          typeof part === "string" ? (
            part
          ) : (
            <em class:list={["font-display text-[1.12em] tracking-[-0.01em]", part.accent && "text-accent"]}>
              {part.em}
            </em>
          ),
        )
      }
    </p>
  </div>
</section>

<script>
  import "./manifesto.motion";
</script>
