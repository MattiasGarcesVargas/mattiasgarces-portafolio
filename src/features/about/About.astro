---
/**
 * Act 05 — about. On desktop the section is taller than the screen and its content sticks, so the
 * black-and-white portrait can rise from the bottom up with the scroll. Mobile is a plain stack.
 * Numbers are rendered final in the HTML; motion only replays the count.
 */
import { getLocale, useTranslations } from "../../shared/i18n/utils";

const t = useTranslations(getLocale(Astro.url));

const pad = (n: number) => String(n).padStart(2, "0");
---

<section class="px-gutter py-[clamp(5rem,8vw,7.5rem)] md:h-[190svh] md:py-0" data-motion="about" data-theme="paper" aria-labelledby="about-title">
  <div class="grid grid-cols-12 items-center gap-x-6 gap-y-12 md:sticky md:top-0 md:h-svh">
    <figure class="col-span-12 m-0 md:col-span-5 lg:col-span-4">
      <div class="aspect-[9/16] overflow-hidden bg-ink md:w-[min(100%,calc(86svh*9/16))]" data-about-frame>
        <img
          class="size-full object-cover"
          src="/me/portrait.jpg"
          alt={t.about.portraitAlt}
          width="1200"
          height="1600"
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>

    <div class="col-span-12 flex flex-col gap-8 md:col-span-7 md:col-start-6 md:gap-[clamp(1rem,3vh,2rem)]">
      <span class="font-mono text-[11px] tracking-[0.08em] text-muted uppercase">{t.about.label}</span>
      <h2
        id="about-title"
        class="font-display text-[clamp(3.5rem,min(9vw,15vh),9rem)] leading-[0.86] tracking-[-0.04em]"
        data-about-title
      >
        {t.about.titleLines[0]}<br />{t.about.titleLines[1]} <em>{t.about.titleEm}</em>
      </h2>
      <p class="max-w-[34ch] text-[clamp(1.125rem,1.6vw,1.25rem)] leading-[1.45] tracking-[-0.01em]">{t.about.body}</p>

      <dl class="flex flex-wrap gap-x-12 gap-y-6 border-t border-line pt-6">
        {
          t.about.stats.map((stat) => (
            <div class="flex flex-col-reverse">
              <dt class="font-mono text-[11px] tracking-[0.08em] text-muted uppercase">{stat.label}</dt>
              <dd class="m-0 font-display text-[clamp(3rem,5vw,4rem)] leading-none tabular-nums">
                <span data-count={stat.value}>{stat.value === 0 ? "0" : pad(stat.value)}</span>
                {stat.suffix}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<script>
  import "./about.motion";
</script>
